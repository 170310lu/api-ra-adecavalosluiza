generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Raca {
  id             Int      @id @default(autoincrement())
  nome           String
  origem         String
  alturaMediaCm  Int
  pesoMedioKg    Int
  pelagem        String
  temperamento   String
  finalidade     String
  descricao      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}